import secrets
import hmac
import hashlib
secret = input("Enter secret key: ")
nonce = secrets.token_hex(8)
print("Nonce:", nonce)

client_hash = hmac.new(
    secret.encode(),
    nonce.encode(),
    hashlib.sha256
).hexdigest()

print("Client Hash:", client_hash)

server_hash = hmac.new(
    secret.encode(),
    nonce.encode(),
    hashlib.sha256
).hexdigest()

if hmac.compare_digest(client_hash, server_hash):
    print("Authentication Successful")
else:
    print("Authentication Failed")

print("\nReplay Attack")

old_hash = client_hash

new_nonce = secrets.token_hex(8)
print("New Nonce:", new_nonce)

new_server_hash = hmac.new(
    secret.encode(),
    new_nonce.encode(),
    hashlib.sha256
).hexdigest()

if hmac.compare_digest(old_hash, new_server_hash):
    print("Authentication Successful")
else:
    print("Replay Attack Detected")
